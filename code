import turtle as t
 
tree1 = [[(100,250) , (80,200) , (120,200) , (100,200)],]
ground = [ ( -400 , -100 ) , ( 400, -100 ) , ( 400 , -300 ) , ( -400 , -300 ) ]
 
def draw_fillcolor_ground() :
    pen1.penup()
    pen1.goto(ground[0])      
    pen1.pendown()
    pen1.fillcolor("#89c3eb")
    pen1.begin_fill()
 
    pen1.goto(ground[1])
    pen1.goto(ground[2])
    pen1.goto(ground[3])
    pen1.goto(ground[0])  
    pen1.end_fill()       
 
def draw_gift_box():
   
    pen2.penup()
    pen2.pensize(1)
   
 
   
    pen2.goto(180, -100)  
    pen2.pendown()
    pen2.color("black", "red")  
    pen2.begin_fill()
    for _ in range(2):
        pen2.forward(80)  
        pen2.left(90)
        pen2.forward(80)  
        pen2.left(90)
    pen2.end_fill()
   
   
    pen2.penup()
    pen2.goto(210, -100)
    pen2.pendown()
    pen2.color("black", "yellow")
    pen2.begin_fill()
    for _ in range(2):
        pen2.forward(20)
        pen2.left(90)
        pen2.forward(80)  
        pen2.left(90)
    pen2.end_fill()
 
   
    pen2.penup()
    pen2.goto(180, -70)  
    pen2.pendown()
    pen2.color("black", "yellow")
    pen2.begin_fill()
    for _ in range(2):
        pen2.forward(80)
        pen2.left(90)
        pen2.forward(20)
        pen2.left(90)
    pen2.end_fill()
 
 
screen = t.Screen()
screen.setup(800, 600)
screen.bgcolor("black")
 
pen1 = t.Turtle()
pen2 = t.Turtle()
pen1.speed(0)
pen1.hideturtle()
pen2.speed(0)
pen2.hideturtle()
 
pen1.color("green")
pen2.color("white")
 
draw_fillcolor_ground()
draw_gift_box()
 
t.done()
 
